# Local development: cp .env.example .env
# Server: .env is generated from AWS Secrets Manager / SSM; never copy this file there.
# Values here are for the local Docker stack only. Real secrets live in AWS Secrets Manager / SSM.

# Postgres
POSTGRES_USER=gyra
POSTGRES_PASSWORD=gyra_local_only
POSTGRES_DB=gyra
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=gyra_local_only
# Host port; change it if something else on your machine already uses 6379
REDIS_PORT=6379

# Mailpit (local email catcher)
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Backend (host mode and tests). Must match the values above; containers get their own URLs from compose.
NODE_ENV=development
# URL-encode passwords that contain special characters.
DATABASE_URL=postgresql://gyra:gyra_local_only@localhost:5432/gyra
REDIS_URL=redis://:gyra_local_only@localhost:6379
BACKEND_PORT=4000
